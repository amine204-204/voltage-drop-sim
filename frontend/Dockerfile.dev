FROM node:20-alpine

WORKDIR /app

# Cache dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the application
COPY . .

EXPOSE 4200

# Force host to 0.0.0.0 and enable polling for file system changes
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--poll", "2000", "--proxy-config", "proxy.conf.json"]
